# Environnement local contre l'emulateur Azurite.
#
# La cle demandee est la CLE PUBLIQUE DE DEVELOPPEMENT d'Azurite : identique
# pour tout le monde, publiee par Microsoft, et sans acces a un compte reel.
#   https://learn.microsoft.com/azure/storage/common/storage-use-azurite
#   (section "Use well-known storage account and key")
#
# Elle n'est pas recopiee dans ce fichier : aucun secret, meme inoffensif, ne
# doit trainer dans un depot public, pour qu'un audit automatique ne puisse
# jamais confondre cette valeur avec une vraie cle.
#
#   cp .env.azurite.example .env
#   # renseigner AZURITE_KEY dans .env
#   set -a && source .env && set +a

export AZURITE_KEY='<a-copier-depuis-la-documentation>'

export STORE_BACKEND=azure
export STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=${AZURITE_KEY};BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;"
export STORAGE_ACCOUNT_URL='http://127.0.0.1:10000/devstoreaccount1'
export PUBLIC_BASE_URL='http://127.0.0.1:8001'
